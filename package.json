{
  "name": "amaliacicalaphotos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run photos && vite --host 0.0.0.0",
    "build": "npm run photos && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "photos": "node scripts/build-photos.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.2.7",
    "@fontsource/syne": "^5.2.7",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.12.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.10.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
